{
  "name": "stock-market-game",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "type": "module",
  "description": "股票模拟游戏 — 一份 engine + 三端部署（纯前端 WASM / 前后端分离 / Tauri 桌面）",
  "scripts": {
    "dev": "corepack pnpm --filter web dev",
    "build": "corepack pnpm --filter web build",
    "test": "node scripts/run-full-regression.mjs",
    "test:e2e": "corepack pnpm --filter web test:e2e",
    "types:generate": "cargo test -p engine export_bindings",
    "types:check": "corepack pnpm types:generate && node scripts/check-generated-types.mjs",
    "wasm:check-threading": "node scripts/check-wasm-threading.mjs",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && corepack pnpm --filter web lint",
    "preview": "corepack pnpm --filter web preview",
    "test:market-performance:unit": "node scripts/run-with-deadline.mjs 10000 -- node --test --test-timeout=10000 --test-isolation=none scripts/performance/market-ui-report.test.mjs",
    "test:market-performance": "node scripts/performance/market-ui-report.mjs"
  }
}

+            Err(Model(CalendarClockModelError::Calendar(_)))
+        ));
+    }
+    assert!(matches!(
+        source.day(date("2030-01-01")),
+        Err(Model(CalendarClockModelError::CurrentBeforeStart { .. }))
+    ));
+    assert!(CivilDate::from_iso("2030-02-30").is_err());
+}

+        ),
+        Err(Model(CalendarClockModelError::DuplicateStock {
+            stock: SSE
+        }))
+    ));
+    for bad in ["1999-12-31", "2100-01-01"] {
+        assert!(matches!(
+            MarketCalendarSource::new(calendar(true), date(bad), BINDINGS.to_vec()),
+            Err(Model(CalendarClockModelError::Calendar(_)))
+        ));
+    }
+    let source = source();
+    for bad in ["1999-12-31", "2100-01-01"] {
+        assert!(matches!(

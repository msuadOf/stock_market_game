+fn c11_source_bindings_and_runtime_date_range_are_validated() {
+    assert!(matches!(
+        MarketCalendarSource::new(calendar(true), date("2030-01-02"), vec![]),
+        Err(Model(CalendarClockModelError::EmptyBindings))
+    ));
+    assert!(matches!(

rovince":"北京市","city":"北京城区","siteName":"中国证券登记结算有限责任公司","orderStatus":"0","addressName":"","addressSearch":"0","type":"单站","url":"http://www.chinaclear.cn/zdjs/home.shtml"},"siteCode_hn":"0","totalSearch":4,"flag":"","columns":[{"id":6623,"siteCode":"N000000672","isOpen":0,"channel":"全部","isDeleted":0,"channelUrl":"","showLable":1,"indexChannel":"中国结算投资者教育基地,资讯中心,法律规则,网上业务平台,服务支持","style":0,"citySearch":0,"lorder":1}, {"id":6660,"siteCode":"N000000672","isOpen":0,"channel":"资讯中心","isDeleted":0,"showLable":1,"indexChannel":"资讯中心","style":0,"citySearch":0,"lorder":2}, {"id":6659,"siteCode":"N000000672","isOpen":0,"channel":"法律规则","isDeleted":0,"showLable":1,"indexChannel":"法律规则","style":0,"citySearch":0,"lorder":3}, {"id":6661,"siteCode":"N000000672","isOpen":0,"channel":"服务支持","isDeleted":0,"showLable":1,"indexChannel":"服务支持","style":0,"citySearch":0,"lorder":4}, {"id":6668,"siteCode":"N000000672","isOpen":0,"channel":"服务表格","isDeleted":0,"channelUrl":"","showLable":1,"indexChannel":"服务支持","style":0,"citySearch":0,"lorder":5}, {"id":9124,"siteCode":"N000000672","isOpen":0,"channel":"接口规范","isDeleted":0,"showLable":1,"indexChannel":"全部","style":0,"citySearch":0,"lorder":8}, {"id":9919,"siteCode":"N000000672","isOpen":0,"channel":"投资者教育","isDeleted":0,"showLable":1,"indexChannel":"中国结算投资者教育基地","style":0,"citySearch":0,"lorder":9}],"columnId":"6623","recentSearchlinkedList":["红股"],"conditionArrayResult":["时间不限", "一年内", "一月内", "一周内", "一日内", "全文匹配", "标题匹配", "默认排序", "按相关度", "按时间倒序", "全部格式", "高级搜索", "文号搜索", "二次搜索", "相关结果", "个", "时间范围", "查询范围", "排序方式", "附件类型", "已显示", "的搜索结果。仍然搜索", "很抱歉，未找到与", "相关的内容", "温馨提示", "请检查您的输入是否正确", "请简化查询词或尝试其他相关词", "阅读", "搜索使用帮助", "的最新相关消息", "文号", "发布机构", "相似文章", "咨询电话", "办理对象", "办理地址", "办事时间", "办理时限", "办理条件", "设立依据", "办理窗口", "机构名称", "办理备注", "问题解答", "办事流程", "办理时限", "法定期限", "附件名称", "收费标准", "收费内容", "办理依据", "受理方式", "受理机构", "申办材料", "事项类别", "办理流程", "决定机构", "图片", "视频", "相关搜索", "智能推荐", "展开", "相关领导", "相关推荐", "发布机构", "发布时间", "文种", "搜索关键词", "包含全部信息", "包含任意信息", "不包含关键词", "文档格式", "全部时间", "按相关度排序", "按时间排序", "搜索位置", "任何地方", "仅标题", "发文关键词", "发文种类", "发文年份", "发文号", "检索全网发文", "热搜词", "多个关键字可用空格区分", "排除关键词", "发文第几号文件", "上一页", "下一页", "收起", "搜一下", "自定义", "从", "至", "确定", "您是不是要搜索", "最近搜索记录", "清除所有搜索记录", "按时间正序", "附件搜索"],"siteName":"中国证券登记结算有限责任公司","lastVisitTime":"2026-10-27 20:31:33","vEnter":"\n","searchStyle":{"id":1688,"siteCode":"N000000672","style":0,"headPosition":1,"color":"#2D448D","topColor":"#FFFFFF","firstLogo":"https://zs.kaipuyun.cn/obssearch/logo/bdc16871383648208cdad79a9170ba15","secondLogo":"https://zs.kaipuyun.cn/obssearch/logo/ee3bd02257c44a2499d7a5b5e1032ae1","footerDesc":"<div class=\"fotnav\" style=\"margin-bottom: 12px; list-style: none; color: rgb(204, 204, 204); font-family: \" microsoft=\"\" yahei\",=\"\" 微软雅黑,=\"\" 宋体,=\"\" tahoma,=\"\" verdana,=\"\" arial,=\"\" sans-serif;=\"\" text-align:=\"\" center;=\"\" background-color:=\"\" rgb(246,=\"\" 246,=\"\" 246);\"=\"\"><span style=\"list-style-type: none; font-family: Arial; background-color: rgb(45, 68, 141);\">Copyright©\u2002|\u20022003</span><span style=\"list-style-type: none; font-family: Arial; background-color: rgb(45, 68, 141);\">-2021\u2002|\u2002开普云信息科技股份有限公司版权所有\u2002|\u2002粤ICP备09112131号-1 |\u2002</span><br></div><div style=\"list-style-type: none; color: rgb(204, 204, 204); font-family: Arial; background-color: rgb(45, 68, 141);\">建议使用IE10及以上浏览器 1280x800及以上分辨率\u2002|\u2002支持IPv6访问&nbsp;|\u2002</div><p></p>","appFooterDesc":"","noFoundTips":"<div class=\"tips\" style=\"margin-bottom: 16px; color: rgb(51, 51, 51);\">温馨提示：</div><div class=\"listTips\" style=\"margin-bottom: 5px; color: rgb(51, 51, 51);\"><span style=\"margin-top: -2px; margin-right: 8px; width: 4px; height: 4px; background: rgb(102, 102, 102); display: inline-block; vertical-align: middle;\"></span>&nbsp;请检查您的输入是否正确</div><div class=\"listTips\" style=\"margin-bottom: 5px; color: rgb(51, 51, 51);\"><span style=\"margin-top: -2px; margin-right: 8px; width: 4px; height: 4px; background: rgb(102, 102, 102); display: inline-block; vertical-align: middle;\"></span>&nbsp;请简化查询词或尝试其他相关词</div><div class=\"listTips\" style=\"margin-bottom: 5px; color: rgb(51, 51, 51);\"><span style=\"margin-top: -2px; margin-right: 8px; width: 4px; height: 4px; background: rgb(102, 102, 102); display: inline-block; vertical-align: middle;\"></span>&nbsp;阅读&nbsp;<a style=\"cursor:pointer;color: rgb(0, 136, 204);\" onclick=\"searchHelp()\">搜索使用帮助</a></div>","createTime":"2021-10-18 10:37:09","updateTime":"2022-12-22 09:29:24","classificationSize":16,"messageSize":14,"titleSize":18,"summarySize":14,"sourceDateSize":13,"jumpLogo":"#","partyGovernmentOfficesId":"","partyGovernmentOfficesLogo":"","footerColor":"#2D448D","errorCorrectionFlag":0,"partygovFlag":0,"columnLabelSize":12,"siteGroupStyle":0,"groupName":"统计信息","groupSort":1,"searchHover":0,"pageWidth":0,"searchBoxWidth":450,"firstLogoHeight":0,"secondLogoHeight":0,"conditionsPattern":0},"webConfig":{"id":3460,"siteCode":"N000000672","type":"高级搜索,热搜词,下拉词联想,搜索排行,缩略图显示带图文章,","createTime":"2021-10-18 10:37:09","updateTime":"2025-02-13 19:25:29"},"allSearchWord":"红股","hotWords":["投资者", "基金", "电子凭证", "结算规则", "证券", "培训"],"siteCode":"N000000672","docYear":"","docType":"","showChannel":true,"column":"全部","searchResultAll":{"searchProposal":"","searchTotal":[{"topical":"","zfgbnf":"","keywords":["关于长江电力、白云机场由深圳市场转登记至上海市场及其他相关事项的通知"],"memo":"2005-11-01","third_column":"已废止业务规则","source":"","govWork":"","zfgbqs":"","ztflx":"","xxgk_effectiveDate":"","id":"2456c549839e456a90fb15307071dd46_a6b7daddd8e340d1b000e39102864f18_N000000672","cwrq":"","image":"","shortContent":"各证券公司： 为积极支持长江电力、白云机场股权分置改革，适应长江电力、白云机场权证发行与交易的需要，保护投资者权益，经中国证监会同意，兹决定对上海市场发行深圳市场配售股份长江电力（003900）和白云机场（003004）实施跨市场转登记，请你们及时通知相关投资者办理配售股份转登记，现就有关事项通知如下： 一、 长江电力和白云机场深圳市场配售股份（以下简称\u201c配售股份\u201d）跨市场转登记是指深市投资者将其持有的长江电力或白云机场从其深圳证券账户转登记至其上海证券账户中。跨市场转登记以证券账户为单位，除长江电力或白云机场外，如该投资者在其深圳证券账户内持有其他上海市场发行深圳市场配售的股份（003XXX），该类配售股份将同时转登记至其上海证券账户中。 二、 配售股份跨市场转登记分两个阶段实施，第一阶段为配售股份跨市场转登记申报及批处理阶段，实施时间从2005年11月14日至2005年11月25日；第二阶段为配售股份余股挂账及投资者补登记处理阶段，即对第一阶段因投资者未申报或申报无效而未成功转入投资者上海证券账户的剩余配售股份进行挂账处理，实施时间是第一阶段结束后。 三、 在深圳市场持有配售股份的","appendix":[],"pubDate":"2024-12-31 19:07:57","topicType":"","urlMD5":"67678c90ddcf30f84a0fd30c40ee40d0","fourth_column":"已废止业务规则","likeDoc":[],"zfgblb":"","pubName":"","second_column":"业务规则","indexno":"","interact":"","siteName":"中国证券登记结算有限责任公司","video":"","creatDate":"","title":"关于长江电力、白云机场由深圳市场转登记至上海市场及其他相关事项的通知（2005年11月1日施行，已废止）","content":"投资者持有的配售股份可继续在深圳市场卖出，配售股份相关权益分派仍在深圳市场处理；但进入第二阶段配售股份余股挂账处理后，投资者持有挂账的配售股份，虽仍可以获得相应的现金分红、送<span>红股</span>","codeName":"yyfzywgz","govDoc":{"docNum":"","docYear":"","docType":"","docNo":""},"fifth_column":"","fwrq":"","address":{"locationCounty":"","locationProvince":"北京市","locationCity":"北京城区"},"siteCode":"N000000672","zwcontent":"","dataPlatform":"","abstracts":"","zwtitle":"","column":"法律规则","xxgk_abolishDate":"","label":"已废止业务规则","sixth_column":"","url":"http://www.chinaclear.cn/zdjs/yyfzywgz/202412/2456c549839e456a90fb15307071dd46.shtml","snapshotUrl":"http://www.chinaclear.cn/zdjs/yyfzywgz/202412/2456c549839e456a90fb15307071dd46.shtml","xxgk_effectiveStatus":"","serviceEntryURL":"","channel_levels_names":"法律规则@@@@@业务规则@@@@@已废止业务规则@@@@@已废止业务规则","taskId":""}, {"topical":"","zfgbnf":"","keywords":["关于沪深交易所跨市场市值配售股份转登记的通知 (2006-07-07)"],"memo":"","third_column":"通知公告","source":"","govWork":"","zfgbqs":"","ztflx":"","xxgk_effectiveDate":"","id":"1d5066ac08684b5a8bbae7fc7e5b2092_2955f9bb2eb14c34b514620deef6621c_N000000672","cwrq":"","image":"","shortContent":"关于沪深证券交易所跨市场市值配售股份转登记的通知 为积极支持上市公司股权分置改革，适应权证发行与交易等市场创新需要，保护投资者权益，经中国证监会同意，兹决定对上海、深圳证券交易所跨市场市值配售股份（上海证券代码为609XXX、深圳证券代码为003XXX,以下统称\u201c配售股份\u201d）实施转登记，现就有关事项通知如下： 一、持有深圳市场发行上海市场配售股份（证券代码为609XXX上市地为深圳,以下简称深市发行沪市配售股份）或上海市场发行深圳市场配售股份（证券代码为003XXX上市地为上海,以下简称沪市发行深市配售股份）的投资者需按本通知要求在规定时间内向其配售股份托管的证券公司提出转登记申请，将其持有的深市发行沪市配售股份（609XXX）从其上海证券账户转登记至其深圳证券账户，或者将其持有的沪市发行深市配售股份（003XXX）从其深圳证券账户转登记至其上海证券账户。 二、转登记申请以证券账户为单位，持有配售股份的投资者可以书面、电话以及其他方式向其配售股份托管的证券公司申请办理股份转登记，投资者申请办理转登记时须如实申报姓名、身份证号、沪深证券账户号等内容，证券公司应认真审核投资者身份资料，确保","appendix":[],"pubDate":"2007-05-10 08:00:00","topicType":"","urlMD5":"380052ccaf5497ae0c4d462c7be1e736","fourth_column":"公司总部","likeDoc":[],"zfgblb":"","pubName":"","second_column":"公告与动态","indexno":"","interact":"","siteName":"中国证券登记结算有限责任公司","video":"","creatDate":"","title":"关于沪深交易所跨市场市值配售<span>股</span>份转登记的通知 (2006-07-07)","content":"对于已成功转入投资者深圳证券账户的配售股份，投资者可通过其深圳证券账户直接卖出，该部分股份的权益分派在深圳市场办理；对于未成功办理转登记而被挂账处理的配售股份，投资者虽仍可获得相应的现金分红、送<span>红股</span>和转赠股份等权益日开始，对于已成功转入投资者上海证券账户的配售股份，投资者可通过其上海证券账户直接卖出，该部分股份的权益分派在上海市场办理；对于未成功办理转登记而被挂账处理的配售股份，投资者虽仍可获得相应的现金分红、送<span>红股</span>和转赠股份等权益","codeName":"gszb","govDoc":{"docNum":"","docYear":"","docType":"","docNo":""},"fifth_column":"","fwrq":"","address":{"locationCounty":"","locationProvince":"北京市","locationCity":"北京城区"},"siteCode":"N000000672","zwcontent":"","dataPlatform":"","abstracts":"","zwtitle":"","column":"资讯中心","xxgk_abolishDate":"","label":"公司总部","sixth_column":"","url":"http://www.chinaclear.cn/zdjs/gszb/201306/1d5066ac08684b5a8bbae7fc7e5b2092.shtml","snapshotUrl":"http://www.chinaclear.cn/zdjs/gszb/201306/1d5066ac08684b5a8bbae7fc7e5b2092.shtml","xxgk_effectiveStatus":"","serviceEntryURL":"","channel_levels_names":"资讯中心@@@@@公告与动态@@@@@通知公告@@@@@公司总部","taskId":""}, {"topical":"","zfgbnf":"","keywords":["跨市场配售股份转登记业务投资者问题解答 (2006-07-06)"],"memo":"","third_column":"通知公告","source":"","govWork":"","zfgbqs":"","ztflx":"","xxgk_effectiveDate":"","id":"8bd925ad7ff9486b8da3686a1227d7b6_2955f9bb2eb14c34b514620deef6621c_N000000672","cwrq":"","image":"","shortContent":"跨市场市值配售股份转登记业务投资者问题解答 1、问：什么是跨市场市值配售股份？ 答：跨市场市值配售股份（以下简称：配售股份）是指在2002年5月\u2015\u20152005年8月期间，为了方便投资者新股认购，上海、深圳两地证券市场共同配合实行新股跨市场市值配售方式发行的股份。这种跨市场市值配售发行的股份有两种：一是上海市场投资者可以凭其上海证券账户上股份市值认购的深圳市场发行中小板企业配售股份（证券代码为609***），该配售股份登记在其上海证券账户上；二是深圳市场投资者可以凭其深圳证券账户上股份市值认购的上海市场发行股份（证券代码为003***），该配售股份登记在其深圳证券账户上。 2、问：什么是配售股份转登记？ 答：配售股份转登记是指投资者将其持有的深圳发行上海配售股份（证券代码：609***）从其上海证券账户转登记至其深圳证券账户，相应的证券代码变为002***；或者投资者将其持有的上海发行深圳配售股份（证券代码：003***）从其深圳证券账户转登记至其上海证券账户，相应的证券代码变为600***。 3、问：为什么要进行配售股份转登记？ 答：为了适应权证发行与交易等市场创新需要，切实保护投资者权","appendix":[],"pubDate":"2007-05-10 08:00:00","topicType":"","urlMD5":"d194001de5c1015f30ac9af744d1c9e8","fourth_column":"公司总部","likeDoc":[],"zfgblb":"","pubName":"","second_column":"公告与动态","indexno":"","interact":"","siteName":"中国证券登记结算有限责任公司","video":"","creatDate":"","title":"跨市场配售<span>股</span>份转登记业务投资者问题解答 (2006-07-06)","content":"虽仍可获得相应的现金分红、送<span>红股</span>和转赠股份等权益，但该部分股份的权益领取、股份卖出、参与新股配售市值计算及配股等事项，需要在该股份补登记后才能办理。","codeName":"gszb","govDoc":{"docNum":"","docYear":"","docType":"","docNo":""},"fifth_column":"","fwrq":"","address":{"locationCounty":"","locationProvince":"北京市","locationCity":"北京城区"},"siteCode":"N000000672","zwcontent":"","dataPlatform":"","abstracts":"","zwtitle":"","column":"资讯中心","xxgk_abolishDate":"","label":"公司总部","sixth_column":"","url":"http://www.chinaclear.cn/zdjs/gszb/201306/8bd925ad7ff9486b8da3686a1227d7b6.shtml","snapshotUrl":"http://www.chinaclear.cn/zdjs/gszb/201306/8bd925ad7ff9486b8da3686a1227d7b6.shtml","xxgk_effectiveStatus":"","serviceEntryURL":"","channel_levels_names":"资讯中心@@@@@公告与动态@@@@@通知公告@@@@@公司总部","taskId":""}, {"topical":"","zfgbnf":"","keywords":["关于发布《中国证券登记结算有限责任公司深圳分公司配售股份跨市场转登记业务指南》的通知"],"memo":"2006-07-07","third_column":"通知公告","source":"","govWork":"","zfgbqs":"","ztflx":"","xxgk_effectiveDate":"","id":"93e5ec739fa1481bb29c0f54e1f2485c_5bf9471645a345a9b5e7db6db5a3c716_N000000672","cwrq":"","image":"","shortContent":"\u2002 \u2002 \u2002 特急 中国证券登记结算有限责任公司深圳分公司文件 \u2002 \u2002 中国结算深业字〔2006〕14号 \u2002 \u2002 关于发布《中国证券登记结算有限责任公司深圳分公司配售股份跨市场转登记业务指南》的通知 \u2002 各证券公司、基金托管银行： \u2002\u2002\u2002 为方便各证券公司、各基金托管银行办理配售股份跨市场转登记业务，保护投资者权益，确保转登记工作顺利进行，我公司根据上海证券交易所、深圳证券交易所及中国证券登记结算有限责任公司联合发布的《关于沪深证券交易所跨市场市值配售股份转登记的通知》等有关规定，制订了《中国证券登记结算有限责任公司深圳分公司配售股份跨市场转登记业务指南》。现将该指南发给你们，请遵照执行。 \u2002\u2002\u2002 特此通知。 附件：《中国证券登记结算有限责任公司深圳分公司配售股份跨市场转登记业务指南》 \u2002 \u2002 \u2002 \u2002 二〇〇六年七月七日 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 \u2002 主题词：转登记\u2002 业务指南\u2002 通知 \u2002 抄送：公司总部。 \u2002 中国证券登记结算有限责任公司深圳分公司\u2002\u2002\u2002\u2002\u2002\u2002 2006年7月8日印发 \u2002打字：黄明珍\u2002\u2002\u2002\u2002\u2002\u2002\u2002\u2002\u2002 校对：张\u2002 琪\u2002\u2002\u2002\u2002\u2002\u2002\u2002\u2002\u2002 共印：5份 ","appendix":[],"pubDate":"2006-08-11 08:00:00","topicType":"","urlMD5":"da0dfa0a8a8be8e94b0b9cfd31f4267a","fourth_column":"深圳分公司","likeDoc":[],"zfgblb":"","pubName":"","second_column":"公告与动态","indexno":"","interact":"","siteName":"中国证券登记结算有限责任公司","video":"","creatDate":"","title":"[深圳]关于发布《中国证券登记结算有限责任公司深圳分公司配售<span>股</span>份跨市场转登记业务指南》的通知","content":"则<span>红股</span>转上海，股息仍然通过深圳系统发放。","codeName":"szfgsgg","govDoc":{"docNum":"","docYear":"","docType":"","docNo":""},"fifth_column":"","fwrq":"","address":{"locationCounty":"","locationProvince":"北京市","locationCity":"北京城区"},"siteCode":"N000000672","zwcontent":"","dataPlatform":"","abstracts":"","zwtitle":"","column":"资讯中心","xxgk_abolishDate":"","label":"深圳分公司","sixth_column":"","url":"http://www.chinaclear.cn/zdjs/szfgsgg/201306/93e5ec739fa1481bb29c0f54e1f2485c.shtml","snapshotUrl":"http://www.chinaclear.cn/zdjs/szfgsgg/201306/93e5ec739fa1481bb29c0f54e1f2485c.shtml","xxgk_effectiveStatus":"","serviceEntryURL":"","channel_levels_names":"资讯中心@@@@@公告与动态@@@@@通知公告@@@@@深圳分公司","taskId":""}],"searchCondition":{"allSearchWord":"红股","column":"中国结算投资者教育基地,资讯中心,法律规则,网上业务平台,服务支持","endTime":"","orderBy":0,"pageNum":0,"pageSize":100,"siteCode":"N000000672","startTime":"","wordPlace":0},"mapWord":"","zdAggsData":{"total":4,"data":[{"key2":"公告与动态","doc_count":3,"sonDatas":{"公告与动态sonData":[{"key2":"公司总部","doc_count":3,"sonDatas":{"公司总部":2,"深圳分公司":1},"key":"通知公告"}],"公告与动态":3},"key":"资讯中心"}, {"key2":"业务规则","doc_count":1,"sonDatas":{"业务规则":1,"业务规则sonData":[{"key2":"已废止业务规则","doc_count":1,"sonDatas":{"已废止业务规则":1},"key":"已废止业务规则"}]},"key":"法律规则"}],"queryData":{"fragment":false,"name":"bool","writeableName":"bool"}},"existInCacheBox":"","message":"请求成功","intelligentRecommend":"","searchLeader":"","total":4,"recommendWord":"","searchLeaders":"","thematic":"","status":1000,"newsInfo":[]},"timeStamp":"0","citySearchFlag":"0","activeStatus":"1","thumbnail_open":"1","preArticlesList":[],"searchLogId":"6ae099a66c616c4e552bd0f0","docTypeList":{"total":21415,"data":[],"queryData":{"fragment":false,"name":"bool","writeableName":"bool"}},"organizationTypeList":{"total":21415,"data":[{"doc_count":13,"key":"中国证券登记结算有限责任公司"}, {"doc_count":1,"key":"中国证券登记结算有限责任公司上海分公司"}, {"doc_count":1,"key":"中国证券登记结算有限责任公司北京分公司"}, {"doc_count":1,"key":"中国证券登记结算有限责任公司深圳分公司"}],"queryData":{"fragment":false,"name":"bool","writeableName":"bool"}},"docName4Search":"","fileType":""}
+fn opening_requires_actual_frontier_and_batch_uses_account_identity() {
+    let (registry, book, day, calendar) = fixture();
+    let empty = CashDividendTaxBook::new(
+        AccountId(0),
+        registry.stock().clone(),
+        DividendTaxProfile::IndividualPublicMarket,
+        registry.settled_on(),
+        vec![],
+    )
+    .unwrap();
+    let result = TaxDayBoundaryFacts::prepare(
+        &registry,
+        &[book.clone(), empty],
+        &day,
+        &context(&calendar, &[], Some(day.day)),
+    )
+    .unwrap();
+    assert_eq!(
+        result
+            .books()
+            .iter()
+            .map(|book| book.account())
+            .collect::<Vec<_>>(),
+        vec![AccountId(0), AccountId(1)]
+    );
+    assert_eq!(
+        result
+            .registrations()
+            .iter()
+            .map(|row| (
+                row.account(),
+                row.lots().iter().map(|lot| lot.qty).sum::<u64>()
+            ))
+            .collect::<Vec<_>>(),

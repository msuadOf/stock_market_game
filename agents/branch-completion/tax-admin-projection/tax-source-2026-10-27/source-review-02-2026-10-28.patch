+    );
+    let mut early = CashDividendTaxBook::new(
+        book.account(),
+        book.stock().clone(),
+        DividendTaxProfile::IndividualPublicMarket,
+        date("2026-01-04"),
+        book.lots().to_vec(),
+    )
+    .unwrap();
+    early
+        .record_net_day("unbound-opening-day".into(), registry.settled_on(), 0, None)
+        .unwrap();
+    assert!(matches!(
+        TaxDayBoundaryFacts::prepare(
+            &registry,
+            &[early],
+            &day,
+            &context(&calendar, &[], Some(day.day))
+        ),
+        Err(TaxBoundaryError::MissingAttribution { .. })
+    ));
+    let wrong_stock = CashDividendTaxBook::new(
+        book.account(),
+        StockCode("000001".into()),
+        DividendTaxProfile::IndividualPublicMarket,
+        book.settled_on(),
+        book.lots().to_vec(),
+    )
+    .unwrap();
+    assert!(matches!(
+        TaxDayBoundaryFacts::prepare(
+            &registry,
+            &[wrong_stock],
+            &day,
+            &context(&calendar, &[], Some(day.day))
+        ),
+        Err(TaxBoundaryError::MissingAttribution { .. })
+    ));

+#[test]
+fn depleted_acquisition_and_opening_lot_sources_remain_bound_to_registry_history() {
+    let (registry, market, calendar, mut rows) = actual_world_source();
+    let lot = &registry
+        .holdings()
+        .iter()
+        .find(|holding| holding.holder == HolderId::Account(AccountId(1)))
+        .unwrap()
+        .lots[0];
+    let opening = CashDividendTaxBook::new(
+        AccountId(1),
+        registry.stock().clone(),
+        DividendTaxProfile::IndividualPublicMarket,
+        registry.settled_on(),
+        vec![DividendTaxLot {
+            id: format!("tax:{}", lot.id),
+            qty: lot.qty,
+            acquired_on: lot.acquired_on,
+            source: convert_tax_source(&lot.source),
+            class: TaxShareClass::PublicMarket,
+        }],
+    )
+    .unwrap();
+    let first = TaxDayBoundaryFacts::prepare(
+        &registry,
+        &[opening],
+        &market,
+        &context(&calendar, &rows, Some(market.day)),
+    )
+    .unwrap();
+    let mut sell = market.clone();
+    sell.day = date("2026-01-07");
+    sell.predecessor = first.registry().settlement_frontier().unwrap();
+    sell.actual_market_close.request.day = sell.day;
+    sell.actual_market_close.request.event_id = "dispose-all".into();
+    sell.post_market_actions.clear();
+    let new_rows = vec![
+        ShareMarketConfirmation {
+            account: AccountId(1),
+            receipt_id: 100,
+            stock: registry.stock().clone(),
+            day: sell.day,
+            side: crate::Side::Sell,
+            qty: 1100,
+        },
+        ShareMarketConfirmation {
+            account: AccountId(0),
+            receipt_id: 101,
+            stock: registry.stock().clone(),
+            day: sell.day,
+            side: crate::Side::Buy,
+            qty: 1100,
+        },
+    ];
+    sell.actual_market_close.source = ShareMarketSource::FinalConfirmations {
+        receipts: new_rows
+            .iter()
+            .map(|row| ShareConfirmationRef {
+                account: row.account,
+                receipt_id: row.receipt_id,
+            })
+            .collect(),
+    };
+    rows.extend(new_rows);
+    sell.actual_market_close.request.changes = vec![
+        DayNetChange {
+            holder: HolderId::Account(AccountId(1)),
+            change: -1100,
+            acquisition: None,
+            consume: None,
+        },
+        DayNetChange {
+            holder: HolderId::Account(AccountId(0)),
+            change: 1100,
+            acquisition: Some(NetAcquisition {
+                lot_id: "dispose-all-buy".into(),
+                source: AcquisitionSource::SecondaryMarket {
+                    settlement: "dispose-all".into(),
+                },
+                restriction: ShareRestriction::Unrestricted,
+            }),
+            consume: None,
+        },
+    ];
+    let second = TaxDayBoundaryFacts::prepare(
+        first.registry(),
+        first.books(),
+        &sell,
+        &context(&calendar, &rows, Some(sell.day)),
+    )
+    .unwrap();
+    assert!(second.books()[0].lots().is_empty());
+    let mut next = sell;
+    next.day = date("2026-01-08");
+    next.predecessor = second.registry().settlement_frontier().unwrap();
+    next.actual_market_close.request.day = next.day;
+    next.actual_market_close.request.event_id = "after-depletion".into();
+    next.actual_market_close.request.changes.clear();
+    next.actual_market_close.source = ShareMarketSource::FinalConfirmations { receipts: vec![] };
+    assert!(TaxDayBoundaryFacts::prepare(
+        second.registry(),
+        second.books(),
+        &next,
+        &context(&calendar, &rows, Some(next.day))
+    )
+    .is_ok());
+    for spoof_opening in [false, true] {
+        let mut wrong = second.books()[0].clone();
+        if spoof_opening {
+            wrong.opening_lots[0].source = TaxAcquisitionSource::InitialAllocation {
+                evidence: "伪造已耗尽期初来源".into(),
+            };
+            wrong.days[1].dispositions[0].lot.source = wrong.opening_lots[0].source.clone();
+        } else {
+            wrong.days[0].acquisition.as_mut().unwrap().source =
+                TaxAcquisitionSource::SecondaryMarket {
+                    settlement: "伪造已耗尽取得来源".into(),
+                };
+            wrong.days[1].dispositions[1].lot.source =
+                wrong.days[0].acquisition.as_ref().unwrap().source.clone();
+        }
+        wrong
+            .validate()
+            .expect("反例必须是自洽税账，不能以税账自身损坏代替来源拒绝");
+        assert!(matches!(
+            TaxDayBoundaryFacts::prepare(
+                second.registry(),
+                &[wrong],
+                &next,
+                &context(&calendar, &rows, Some(next.day))
+            ),
+            Err(TaxBoundaryError::MissingAttribution { .. })
+        ));
+    }
+}

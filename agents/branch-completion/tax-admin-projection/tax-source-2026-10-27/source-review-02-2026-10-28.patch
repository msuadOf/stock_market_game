+    day.actual_market_close.request.event_id = "actual-late-buy".into();
+    let rows = vec![
+        ShareMarketConfirmation {
+            account: AccountId(1),
+            receipt_id: 10,
+            stock: registry.stock().clone(),
+            day: day.day,
+            side: crate::Side::Sell,
+            qty: 100,
+        },
+        ShareMarketConfirmation {
+            account: AccountId(2),
+            receipt_id: 11,
+            stock: registry.stock().clone(),
+            day: day.day,
+            side: crate::Side::Buy,
+            qty: 100,
+        },
+    ];
+    day.actual_market_close.source = ShareMarketSource::FinalConfirmations {
+        receipts: rows
+            .iter()
+            .map(|row| ShareConfirmationRef {
+                account: row.account,
+                receipt_id: row.receipt_id,
+            })
+            .collect(),
+    };
+    day.actual_market_close.request.changes = vec![
+        DayNetChange {
+            holder: HolderId::Account(AccountId(1)),
+            change: -100,
+            acquisition: None,
+            consume: None,
+        },
+        DayNetChange {
+            holder: HolderId::Account(AccountId(2)),
+            change: 100,
+            acquisition: Some(NetAcquisition {
+                lot_id: "late-buy".into(),
+                source: AcquisitionSource::SecondaryMarket {
+                    settlement: "actual-late-buy".into(),
+                },
+                restriction: ShareRestriction::Unrestricted,
+            }),
+            consume: None,
+        },
+    ];
+    let result = TaxDayBoundaryFacts::prepare(
+        &registry,
+        std::slice::from_ref(&empty),
+        &day,
+        &context(&calendar, &rows, Some(day.day)),
+    )
+    .unwrap();
+    assert_eq!(result.books()[0].account(), AccountId(2));
+    assert_eq!(result.books()[0].lots()[0].qty, 100);
+    assert_eq!(result.books()[0].days.len(), 1);
+}

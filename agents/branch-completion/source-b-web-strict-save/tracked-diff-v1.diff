+    }
+  } else {
+    for (const [key, nested] of Object.entries(value)) {
+      string(key, `${path}.key`)
+      validateSaveValue(nested, `${path}.${key}`, ancestors)
+    }
+  }
+  ancestors.delete(value)
+}

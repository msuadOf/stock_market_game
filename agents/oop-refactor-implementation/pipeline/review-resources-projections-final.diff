+    fn ensure_sellable_from_snapshot(
+        &mut self,
+        account: AccountId,
+        code: &StockCode,
+        resources: &DecisionResourceSnapshot,
+    ) -> Result<(), StepFatal> {
+        if !self.sellable.contains_key(code) {

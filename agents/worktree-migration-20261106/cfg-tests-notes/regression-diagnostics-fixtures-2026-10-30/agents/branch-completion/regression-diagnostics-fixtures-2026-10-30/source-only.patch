+#[test]
+fn public_step_routes_real_retail_rejections_to_retail_diagnostics() {
+    let mut setup = crate::session::npc_working_quote_tests::retail_quote_setup();
+    setup.auction_ticks = 3;
+    setup.ticks_per_day = 8;
+    setup.closing_auction_ticks = 1;
+    setup.strategy_params.retail.arrival_rate = 0.0;
+    let mut session = GameSession::new(setup, 42).unwrap();
+    session.state.tick = 2;
+    session.fixture_sync_market_modes_for_test();
+    assert!(session.runtime_driver_for_test().is_none());
+    let owner = AccountId(1);
+    let code = StockId(0);
+    assert_eq!(
+        session.account(owner).unwrap().kind(),
+        crate::AccountKind::Retail
+    );
+
+    assert_eq!(session.phase(), TradingPhase::PreOpen);
+    let intents = [
+        Intent::PlaceLimit {
+            code,
+            side: Side::Buy,
+            price: crate::LimitPrice::Fixed(Money::from_cents(900)),
+            qty: 100,
+        },
+        Intent::Cancel {
+            code,
+            id: OrderId(77),
+        },
+    ]
+    .into_iter()
+    .map(|intent| {
+        session
+            .state
+            .ingress_receipt_cursors
+            .receive(owner, intent)
+            .unwrap()
+    })
+    .collect();
+    crate::session::pipeline::staged_decision::stage(
+        crate::session::pipeline::NpcDecisionHandover::new(
+            session.tick(),
+            vec![owner],
+            intents,
+            Vec::new(),
+        ),
+    );
+
+    let events = session.step().unwrap();
+    for reason in [
+        RejectionReason::AuctionOrderEntryClosed,
+        RejectionReason::AuctionOrderNotCancelable,
+    ] {
+        assert!(events.iter().any(|event| matches!(
+            event,
+            Event::IntentRejected { account, code: event_code, reason: event_reason, .. }
+                if *account == owner && *event_code == code && *event_reason == reason
+        )));
+        assert!(session.last_retail_order_events().contains(
+            &RetailOrderDiagnosticEvent::Rejected {
+                account: owner,
+                code,
+                reason
+            }
+        ));
+    }
+}

+#[test]
+fn from_post_expiry_does_not_revalidate_unchanged_envelopes() {
+    // 回归防线（红→绿证据见 findings）：零 op 初始化中每行 envelope 已在
+    // validate_initial_snapshots 全量 Envelope::validate，且期间不可变；
+    // 完整证据路径不应再逐行重跑同一验证。
+    use std::sync::atomic::Ordering;
+    let before =
+        crate::session::pipeline::private_stock_ledger::ENVELOPE_REVALIDATE_ROWS
+            .load(Ordering::SeqCst);
+    let code = stock("600888");
+    let mut market = empty_market(&code);
+    let snapshots = vec![
+        add_resting(&mut market, &code, AccountId(11), OrderId(100), Side::Sell, 100),
+        add_resting(&mut market, &code, AccountId(12), OrderId(101), Side::Sell, 200),
+    ];
+    let _ = IncrementalContinuousStockCoordinator::from_post_expiry(vec![stock_input(
+        market,
+        snapshots,
+        GameConfig::proposed_defaults(),
+    )])
+    .unwrap();
+    let delta = crate::session::pipeline::private_stock_ledger::ENVELOPE_REVALIDATE_ROWS
+        .load(Ordering::SeqCst)
+        - before;
+    assert_eq!(
+        delta, 0,
+        "零 op 初始化不应逐行重跑 Envelope::validate（重验证 {delta} 行）"
+    );
+}
+
+#[test]
+fn from_post_expiry_walks_arrival_order_without_cloning_orders() {
+    // 回归防线（红→绿证据见 findings）：簿序核对按到达序（seq 升序）遍历，
+    // 与 Market::resting_orders 的输出序列一致，但只借用引用、不克隆 Order。
+    use std::sync::atomic::Ordering;
+    let before = super::super::RESTING_ORDER_CLONES.load(Ordering::SeqCst);
+    let code = stock("600888");
+    let mut market = empty_market(&code);
+    let snapshots = vec![
+        add_resting(&mut market, &code, AccountId(11), OrderId(100), Side::Sell, 100),
+        add_resting(&mut market, &code, AccountId(12), OrderId(101), Side::Sell, 200),
+        add_resting(&mut market, &code, AccountId(13), OrderId(102), Side::Sell, 300),
+    ];
+    let _ = IncrementalContinuousStockCoordinator::from_post_expiry(vec![stock_input(
+        market,
+        snapshots,
+        GameConfig::proposed_defaults(),
+    )])
+    .unwrap();
+    let delta = super::super::RESTING_ORDER_CLONES.load(Ordering::SeqCst) - before;
+    assert_eq!(
+        delta, 0,
+        "零 op 初始化不应克隆全簿 Order（resting_orders 克隆 {delta} 次）"
+    );
+}

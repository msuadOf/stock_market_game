+use super::*;
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+pub(super) struct AccountingArchive {
+    pub(super) company_operations: crate::company::operations::CompanyOperations,
+    pub(super) groups: Vec<GroupStructure>,
+    pub(super) closing_registry: ClosingEngine,
+    pub(super) public_library: PublicLibrary,
+    pub(super) clock: crate::session::CivilClockSave,
+    pub(super) wiring: crate::session::CompanyOperationsClockWiring,
+    pub(super) disclosures: crate::session::DisclosureDispatch,
+}
+pub(super) fn fixture(
+    (config, groups): (CompanyOperationsConfig, Vec<GroupStructure>),
+) -> AccountingArchive {
+    let date = CivilDate::from_iso("2030-03-31").unwrap();
+    let mut seeded = crate::information::assemble_seeded_prehistory(config, date).unwrap();
+    seed_groups(&groups, &mut seeded, date).unwrap();
+    let disclosures = crate::session::DisclosureDispatch::new(seeded.last_published_instant());
+    let mut clock =
+        crate::session::CivilClock::new(date, crate::calendar::CalendarExchange::Sse).unwrap();
+    let mut wiring = crate::session::CompanyOperationsClockWiring::new();
+    wiring.install(&mut clock, &seeded.ops).unwrap();
+    AccountingArchive {
+        company_operations: seeded.ops,
+        groups,
+        closing_registry: seeded.closing,
+        public_library: seeded.library,
+        clock: clock.save(),
+        wiring,
+        disclosures,
+    }
+}
+pub(super) fn end_day(state: &mut AccountingArchive) {
+    let date = state.clock.current_date;
+    let mut clock = crate::session::CivilClock::from_parts(
+        CivilDate::from_iso("2030-03-31").unwrap(),
+        &state.clock,
+        crate::calendar::CalendarExchange::Sse,
+    )
+    .unwrap();
+    let report = clock.end_day(date).unwrap();
+    state
+        .wiring
+        .run_day_end(&report, &mut clock, &mut state.company_operations)
+        .unwrap();
+    if date.next().unwrap().month() != date.month() {
+        let period = AccountingPeriod::from_ymd(date.year(), date.month()).unwrap();
+        let ids: Vec<_> = state.company_operations.companies.keys().cloned().collect();
+        for id in ids {
+            let company = state.company_operations.company_mut(&id).unwrap();
+            let member = MemberId(id.0.clone());
+            let industry = crate::information::industry_presentation(company.spec().kind);
+            if date.month() == 12 {
+                state
+                    .closing_registry
+                    .close_year(company.books_mut(), &member, industry, date.year())
+                    .unwrap();
+            } else {
+                state
+                    .closing_registry
+                    .close_month(company.books_mut(), &member, industry, period)
+                    .unwrap();
+            }
+        }
+        record_group_periods(
+            &state.groups,
+            &state.company_operations,
+            &mut state.closing_registry,
+            period,
+        )
+        .unwrap();
+    }
+    state
+        .disclosures
+        .run_day_end(crate::session::DayEndDisclosureCtx {
+            groups: &state.groups,
+            report: &report,
+            ops: &state.company_operations,
+            closing: &mut state.closing_registry,
+            library: &mut state.public_library,
+        })
+        .unwrap();
+    state.wiring.prune_dispatched(&state.company_operations);
+    state.clock = clock.save();
+}
+pub(super) fn restore(
+    saved: &AccountingArchive,
+) -> Result<AccountingArchive, Box<dyn std::error::Error>> {
+    let restored: AccountingArchive = serde_json::from_slice(&serde_json::to_vec(saved)?)?;
+    restored.company_operations.validate_payment_history()?;
+    validate_groups(&restored.groups, &restored.company_operations)?;
+    assert!(restored
+        .wiring
+        .mirror_is_exact(&restored.company_operations));
+    Ok(restored)
+}
+pub(super) fn query(
+    state: &AccountingArchive,
+    query: &PublicReportQuery,
+) -> Result<crate::company::PublicReportPage, InformationError> {
+    state.public_library.query_public_reports(
+        query,
+        CivilInstant::new(state.clock.current_date, 0).unwrap(),
+    )
+}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认窗口能力：自定义 Tauri 命令、engine-event 与日终文件原子替换。支持对话框选中隐藏父目录内的存档目标。风险：fs.requireLiteralLeadingDot=false 使必要命令的项目 UUID 临时文件规则也匹配隐藏父目录；受信任的 main 前端可打开、改写、重命名或删除已由对话框授权的文件，以及任意普通或隐藏目录中匹配该临时命名规则的文件。不授权整个目录、其他未选普通文件或全局文件系统范围。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": ["**/stock-game-day-end-????????-????-4???-[89ab]???-????????????.tmp"]
    },
    {
      "identifier": "fs:allow-open",
      "allow": ["**/stock-game-day-end-????????-????-4???-[89ab]???-????????????.tmp"]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": ["**/stock-game-day-end-????????-????-4???-[89ab]???-????????????.tmp"]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": ["**/stock-game-day-end-????????-????-4???-[89ab]???-????????????.tmp"]
    }
  ]
}

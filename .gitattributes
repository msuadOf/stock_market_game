# Normalize line endings across platforms.
# The repo stores LF; checkouts use the OS default (core.autocrlf handles the conversion).
* text=auto eol=lf

# Windows command scripts require CRLF; cmd.exe can misparse UTF-8 LF-only files.
*.bat text eol=crlf

# Source files are always LF in the repo.
*.{ts,tsx,js,jsx,rs,go,json,yml,yaml,toml,css,scss,html,md,sh} text eol=lf

# Binary files — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.pdf binary

# 保留工作补丁中空白上下文行所需的单个空格，不放宽源码空白检查。
agents/**/*.patch whitespace=-blank-at-eol

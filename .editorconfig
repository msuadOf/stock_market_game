# EditorConfig — https://editorconfig.org
# Keeps formatting consistent across editors/IDEs/OSes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.bat]
end_of_line = crlf

[*.go]
indent_style = tab

[*.md]
trim_trailing_whitespace = false   # markdown hard-breaks rely on trailing spaces

[Makefile]
indent_style = tab                 # make requires tabs
